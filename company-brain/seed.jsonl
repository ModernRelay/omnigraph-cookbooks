{"type": "Claim", "data": {"slug": "bob-cancels-trial", "statement": "Bob cancels the hosted search trial by Oct 5.", "quote": "Bob, please cancel the vendor trial by Monday.", "locator": "00:22:10", "kind": "commitment", "status": "verified", "recorded_at": "2026-10-02T16:00:00.000Z"}}
{"type": "Claim", "data": {"slug": "bob-ships-prototype", "statement": "Bob ships the in-house search prototype to staging by Oct 10.", "quote": "I'll have the prototype on staging by the tenth.", "locator": "00:23:30", "kind": "commitment", "status": "verified", "recorded_at": "2026-10-02T16:00:00.000Z"}}
{"type": "Claim", "data": {"slug": "provider-certifies-nov-6", "statement": "The payment provider certifies Checkout v2 by Nov 6.", "quote": "The provider confirmed certification by November 6, a week before launch.", "locator": "00:09:30", "kind": "fact", "status": "verified", "recorded_at": "2026-09-30T17:00:00.000Z"}}
