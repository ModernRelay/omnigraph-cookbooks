{"type": "Claim", "data": {"slug": "keep-saved-cards", "statement": "Keep saved cards in Checkout v2; forcing re-entry would hurt repeat purchases.", "quote": "Saved cards stay. Making people re-enter a card will cost us repeat purchases.", "locator": "00:18:40", "kind": "proposal", "status": "verified", "recorded_at": "2026-09-30T17:00:00.000Z"}}
