{"type": "Claim", "data": {"slug": "vendor-cheaper", "statement": "A hosted search vendor is cheaper and faster than building ranking in-house.", "quote": "Hosted search is cheaper and faster than building ranking ourselves.", "locator": "1789466400.000100", "kind": "fact", "status": "rejected", "recorded_at": "2026-09-15T11:00:00.000Z"}}
{"type": "Claim", "data": {"slug": "buy-hosted-search", "statement": "Buy a hosted search vendor for the search revamp.", "quote": "Let's buy hosted search for the revamp and stop building ranking.", "locator": "1789466400.000300", "kind": "proposal", "status": "verified", "recorded_at": "2026-09-15T11:00:00.000Z"}}
{"type": "Claim", "data": {"slug": "vendor-quote-3x", "statement": "The hosted vendor's quote is three times the search budget.", "quote": "Forwarding the vendor's quote: $360k a year. That is three times what we budgeted for search.", "locator": "Body", "kind": "fact", "status": "verified", "recorded_at": "2026-09-25T09:00:00.000Z"}}
{"type": "Claim", "data": {"slug": "prototype-meets-latency", "statement": "The in-house search prototype meets the 200 ms latency target.", "quote": "p95 is 140 milliseconds on the full catalog, under our 200 millisecond target.", "locator": "00:06:10", "kind": "fact", "status": "verified", "recorded_at": "2026-10-02T16:00:00.000Z"}}
