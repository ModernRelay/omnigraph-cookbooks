{"type": "Decision", "data": {"slug": "billing-freeze", "title": "Freeze the billing migration until Q1", "statement": "No billing migration work until January; Platform focuses on reliability.", "status": "accepted", "recorded_at": "2026-07-20T12:00:00.000Z", "rationale": "Two outages in June; the team cannot run a migration and an incident rotation at once.", "decided_at": "2026-07-20T10:00:00.000Z"}}
{"type": "Decision", "data": {"slug": "search-vendor-buy", "title": "Buy a hosted search vendor", "statement": "Replace in-house search with a hosted vendor for the revamp.", "status": "accepted", "recorded_at": "2026-09-15T11:00:00.000Z", "rationale": "Faster to ship than building ranking ourselves.", "decided_at": "2026-09-15T10:00:00.000Z"}}
