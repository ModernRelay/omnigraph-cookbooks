{"type": "Claim", "data": {"slug": "three-step-onboarding", "statement": "Cut sign-up onboarding from seven steps to three.", "quote": "Seven steps is too many. Let's ship three and move the rest after sign-up.", "locator": "00:04:20", "kind": "proposal", "status": "unverified", "recorded_at": "2026-10-06T15:00:00.000Z"}}
{"type": "Claim", "data": {"slug": "later-steps-not-needed", "statement": "Nothing in onboarding steps four to seven, including the shipping address, is needed before a first order.", "quote": "Address, notifications, interests, referral: nothing in steps four to seven is needed before someone places a first order.", "locator": "00:07:45", "kind": "fact", "status": "unverified", "recorded_at": "2026-10-06T15:00:00.000Z"}}
{"type": "Claim", "data": {"slug": "dana-drafts-copy", "statement": "Dana drafts copy for the three-step onboarding by Oct 20.", "quote": "I'll draft copy for the three screens by the twentieth.", "locator": "00:31:00", "kind": "commitment", "status": "unverified", "recorded_at": "2026-10-06T15:00:00.000Z"}}
{"type": "Claim", "data": {"slug": "address-step-tickets", "statement": "A third of where-is-my-order tickets come from customers who skipped the shipping address step.", "quote": "A third of our where-is-my-order tickets are from people who skipped the address step in onboarding.", "locator": "1791363600.000200", "kind": "fact", "status": "unverified", "recorded_at": "2026-10-07T10:00:00.000Z"}}
