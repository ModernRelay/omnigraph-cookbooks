{"type": "Decision", "data": {"slug": "checkout-saved-cards", "title": "Keep saved cards in Checkout v2", "statement": "Saved cards stay available in v2; no forced re-entry.", "status": "accepted", "recorded_at": "2026-09-30T17:00:00.000Z", "rationale": "Removing them would hurt repeat purchases.", "decided_at": "2026-09-30T15:40:00.000Z"}}
