// People, teams, actors, projects and sources.

query project_owner($project: String) @description("Who owns a project and which team runs it.") {
    match {
        $p: Project { slug: $project }
        $person: Person
        $p ownedBy $person
    }
    return { $person.name as owner, $person.title as title }
}

query team_members($team: String) @description("Current members of a team: stints no LeftTeam has closed, with their role.") {
    match {
        $t: Team { slug: $team }
        $p: Person
        $p $m:memberOf $t
        not { $p $l:leftTeam $t  $l.since = $m.since }
    }
    return { $p.name as person, $m.role as role, $m.since as since }
    order { person asc }
}

query person_by_handle($handle: String) @description("Resolve an email, Slack member ID or GitHub login to a person, lowercased: alice@lanternworks.example, u01alice, apark.")
                                        @instruction("Run this for every handle a source gives before creating a Person. No row means nobody has that handle yet, not that the person is new.") {
    match {
        $p: Person
        $p.email = $handle or $p.slack = $handle or $p.github = $handle
    }
    return { $p.slug as person, $p.name as name }
}

query person_handles($person: String) @description("A person's title, whether they are active, and their email, Slack member ID and GitHub login. Read these before update_person, which sets them all.") {
    match {
        $p: Person { slug: $person }
    }
    return { $p.name as name, $p.title as title, $p.active as active, $p.email as email, $p.slack as slack, $p.github as github }
}

query actors() @description("Everyone who reads or writes this graph, people's own logins and agents, with the person behind each and whether the actor is active.") {
    match {
        $a: Actor
        $p: Person
        $a actsFor $p
    }
    return { $a.slug as actor, $a.kind as kind, $a.name as name, $a.active as active, $p.name as person }
    order { actor asc }
}

query active_projects() @description("Active projects with their owner, team and target date.") {
    match {
        $p: Project { status: "active" }
        $owner: Person
        $team: Team
        $p ownedBy $owner
        $p runBy $team
    }
    return { $p.name as project, $owner.name as owner, $team.name as team, $p.target_date as target_date }
    order { project asc }
}

query quiet_projects($since: DateTime) @description("Active or paused projects with no meeting, thread or document about them since a time. Pass a fixed time, e.g. 2026-09-14T00:00:00.000Z.") {
    match {
        $p: Project
        $p.status = "active" or $p.status = "paused"
        not { $s sourceAbout $p  $s.occurred_at >= $since }
    }
    return { $p.name as project, $p.status as status }
    order { project asc }
}

query project_sources($project: String) @description("Everything the brain has read about a project, newest first.") {
    match {
        $p: Project { slug: $project }
        $s: Source
        $s sourceAbout $p
    }
    return { $s.title as source, $s.kind as kind, $s.occurred_at as occurred_at }
    order { occurred_at desc }
}

query search_sources($q: String) @description("Full-text search over source titles, best match first.") {
    match {
        $s: Source
    }
    return { $s.slug as source, $s.title as title, $s.kind as kind }
    order { bm25($s.title, $q) }
    limit 20
}
