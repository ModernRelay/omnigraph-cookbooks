.claude/
.docs/

# Logs
*.log

# Packaged skill bundles (generated by `npx skills package`)
*.skill

# Customer-specific migration / mapping docs — kept locally, never committed
vc-os/P9_MIGRATION.md

# Cluster control-plane local state (ledger, catalog, approvals)
__cluster/

# code-graph: checkouts and indexes from sources/fetch.py, the installed indexer
code-graph/sources/work/
code-graph/sources/indexer/node_modules/

# beads client: local graphs from `ob init`, Python bytecode
.ob/
__pycache__/

# Legacy combined config (RFC-008) — cookbooks ship cluster.yaml + an
# omnigraph-config.example.yaml; per-operator config is ~/.omnigraph/config.yaml
omnigraph.yaml

# code-graph benchmarks: clones, checkouts, indexes, graphs
code-graph/bench/work/
